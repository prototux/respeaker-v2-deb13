CONFIG_DEFAULT_DEVICE_TREE="rockchip/rk3229-respeaker-core-v2"
CONFIG_DEFAULT_FDT_FILE="rockchip/rk3229-respeaker-core-v2.dtb"
CONFIG_OF_LIST="rockchip/rk3229-respeaker-core-v2"
CONFIG_IDENT_STRING=" ReSpeaker Core v2"
CONFIG_BAUDRATE=115200
CONFIG_BOOTDELAY=2
# The environment is never saved: "saveenv" on this board would write into the
# raw area between the bootloader and the first partition, possibly
# clobbering another image's data. Customize /boot/boot.cmd instead.
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_MMC is not set
# No random MAC from U-Boot: Linux then flags the MAC as random and systemd
# replaces it by a stable one derived from the machine-id.
# CONFIG_NET_RANDOM_ETHADDR is not set
CONFIG_CMD_PART=y
CONFIG_PARTITION_UUIDS=y
CONFIG_CMD_BOOTZ=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_FS_GENERIC=y
# The evb-rk3229 default (2 KiB) is too small for the devices SPL and U-Boot
# proper bind before relocation ("alloc space exhausted", then "No serial
# driver found"). Both run from DRAM here, so there is room. The TPL runs
# from the 32 KiB SRAM and keeps its default.
CONFIG_SPL_SYS_MALLOC_F_LEN=0x4000
CONFIG_SYS_MALLOC_F_LEN=0x4000
# The EFI boot manager runs first and, with no EFI system partition, only
# prints "Cannot persist EFI variables" / "EFI boot manager: Cannot load any
# image" before the boot script is found. Booting EFI binaries from a
# partition (bootmeth efi) still works.
# CONFIG_BOOTMETH_EFI_BOOTMGR is not set

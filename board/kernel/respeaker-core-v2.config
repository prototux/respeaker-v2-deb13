CONFIG_LOCALVERSION="-respeaker"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_ARCH_ROCKCHIP=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_MODULE_SIG is not set

# systemd
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP=y
CONFIG_ZRAM=m

# PMIC (RK805), clocks for the Wi-Fi/BT LPO, RTC, power key
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y
CONFIG_COMMON_CLK_RK808=y
CONFIG_RTC_DRV_RK808=y
CONFIG_INPUT_RK805_PWRKEY=m
CONFIG_I2C_RK3X=y
CONFIG_ROCKCHIP_IODOMAIN=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_CPUFREQ_DT=y
CONFIG_NVMEM_ROCKCHIP_EFUSE=y
CONFIG_DW_WATCHDOG=y

# Storage
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# Wi-Fi / Bluetooth (AP6212 = BCM43430A1)
CONFIG_CFG80211=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_BCM=y

# Ethernet (internal 100M PHY)
CONFIG_STMMAC_ETH=m
CONFIG_DWMAC_ROCKCHIP=m
CONFIG_ROCKCHIP_PHY=m

# USB
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_USB_DWC2=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD_PLATFORM=y

# LEDs, user button, SPI
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_SPI_ROCKCHIP=y
CONFIG_SPI_SPIDEV=m

# Audio (the AC108 driver is built out of tree, see drivers/ac108)
CONFIG_SND_SOC_ROCKCHIP_I2S=m
CONFIG_SND_SOC_RK3228=m
CONFIG_SND_SIMPLE_CARD=m
CONFIG_SND_USB_AUDIO=m

# HDMI output, Mali-400 GPU
CONFIG_ROCKCHIP_IOMMU=y
CONFIG_DRM_ROCKCHIP=m
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_DW_HDMI=y
CONFIG_PHY_ROCKCHIP_INNO_HDMI=m
CONFIG_DRM_LIMA=m

# USB OTG port as a serial console gadget (ttyGS0), like the vendor image
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_ACM=y

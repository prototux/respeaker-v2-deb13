From: ReSpeaker Core v2 image builder
Subject: [PATCH] regulator: rk808: RK805: support mode and ramp rate on DCDC1/2

The RK805 buck converters 1 and 2 (CPU and logic rails on RK3229 boards)
were registered without set_mode/set_ramp_delay. Two consequences:

- "regulator-initial-mode" is ignored, so the bucks stay in auto PWM/PFM
  mode, while the vendor kernel forces PWM (bit 7 of BUCKx_ON_VSEL).
- "regulator-ramp-delay" is not programmed into BUCKx_CONFIG[4:3]; the
  core still uses it to compute how long to wait after a voltage change,
  so with the slower power-on slew rate the CPU can be clocked up before
  its supply has reached the new voltage.

Add both, using the values and registers of the Rockchip 4.4 driver.

--- a/drivers/regulator/rk808-regulator.c
+++ b/drivers/regulator/rk808-regulator.c
@@ -922,6 +922,28 @@
 	.set_suspend_disable	= rk808_set_suspend_disable,
 };
 
+/* RK805 DCDC1/2 (CPU and logic rails): FPWM mode bit and slew rate too */
+static const unsigned int rk805_buck_ramp_delay_table[] = {
+	3000, 6000, 12500, 25000,
+};
+
+static const struct regulator_ops rk805_buck1_2_ops = {
+	.list_voltage		= regulator_list_voltage_linear_range,
+	.map_voltage		= regulator_map_voltage_linear_range,
+	.get_voltage_sel	= regulator_get_voltage_sel_regmap,
+	.set_voltage_sel	= regulator_set_voltage_sel_regmap,
+	.set_voltage_time_sel	= regulator_set_voltage_time_sel,
+	.enable			= regulator_enable_regmap,
+	.disable		= regulator_disable_regmap,
+	.is_enabled		= regulator_is_enabled_regmap,
+	.set_mode		= rk8xx_set_mode,
+	.get_mode		= rk8xx_get_mode,
+	.set_ramp_delay		= regulator_set_ramp_delay_regmap,
+	.set_suspend_voltage	= rk808_set_suspend_voltage_range,
+	.set_suspend_enable	= rk808_set_suspend_enable,
+	.set_suspend_disable	= rk808_set_suspend_disable,
+};
+
 static const struct regulator_ops rk808_switch_ops = {
 	.enable			= regulator_enable_regmap,
 	.disable		= regulator_disable_regmap,
@@ -1056,13 +1078,18 @@
 		.of_match = of_match_ptr("DCDC_REG1"),
 		.regulators_node = of_match_ptr("regulators"),
 		.id = RK805_ID_DCDC1,
-		.ops = &rk808_reg_ops_ranges,
+		.ops = &rk805_buck1_2_ops,
 		.type = REGULATOR_VOLTAGE,
 		.n_voltages = 64,
 		.linear_ranges = rk805_buck_1_2_voltage_ranges,
 		.n_linear_ranges = ARRAY_SIZE(rk805_buck_1_2_voltage_ranges),
 		.vsel_reg = RK805_BUCK1_ON_VSEL_REG,
 		.vsel_mask = RK818_BUCK_VSEL_MASK,
+		.ramp_reg = RK805_BUCK1_CONFIG_REG,
+		.ramp_mask = GENMASK(4, 3),
+		.ramp_delay_table = rk805_buck_ramp_delay_table,
+		.n_ramp_values = ARRAY_SIZE(rk805_buck_ramp_delay_table),
+		.of_map_mode = rk8xx_regulator_of_map_mode,
 		.enable_reg = RK805_DCDC_EN_REG,
 		.enable_mask = BIT(0),
 		.owner = THIS_MODULE,
@@ -1072,13 +1099,18 @@
 		.of_match = of_match_ptr("DCDC_REG2"),
 		.regulators_node = of_match_ptr("regulators"),
 		.id = RK805_ID_DCDC2,
-		.ops = &rk808_reg_ops_ranges,
+		.ops = &rk805_buck1_2_ops,
 		.type = REGULATOR_VOLTAGE,
 		.n_voltages = 64,
 		.linear_ranges = rk805_buck_1_2_voltage_ranges,
 		.n_linear_ranges = ARRAY_SIZE(rk805_buck_1_2_voltage_ranges),
 		.vsel_reg = RK805_BUCK2_ON_VSEL_REG,
 		.vsel_mask = RK818_BUCK_VSEL_MASK,
+		.ramp_reg = RK805_BUCK2_CONFIG_REG,
+		.ramp_mask = GENMASK(4, 3),
+		.ramp_delay_table = rk805_buck_ramp_delay_table,
+		.n_ramp_values = ARRAY_SIZE(rk805_buck_ramp_delay_table),
+		.of_map_mode = rk8xx_regulator_of_map_mode,
 		.enable_reg = RK805_DCDC_EN_REG,
 		.enable_mask = BIT(1),
 		.owner = THIS_MODULE,

# Every input of the build is pinned here. Change a value, and you get a
# different (but still reproducible) image. Hashes are verified on download.

# Build container: Debian trixie, pinned by digest. Its packages (cross
# compiler, mmdebstrap, qemu...) come from the snapshot below, so the toolchain
# is frozen too.
BUILDER_IMAGE="debian:trixie-20260918-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a"

# snapshot.debian.org timestamp used both for the build container and for the
# target rootfs. The installed image points at deb.debian.org instead, so it
# receives normal updates once booted.
DEBIAN_SNAPSHOT="20261001T000000Z"
DEBIAN_SUITE="trixie"

# DRAM clock set by the bootloader, in MHz: 300, 600, 666 or 786 (timings in
# board/u-boot/dmc/). 600 is the vendor's normal rate; 666 and 786 are
# experimental. Override for one build with DDR_FREQ=300 ./build.sh
DDR_FREQ="600"

# Every timestamp embedded in the image (file mtimes, build dates, ...) is
# clamped to this value. Default: the snapshot date (2026-10-01 00:00:00 UTC).
SOURCE_DATE_EPOCH="1790812800"

LINUX_VERSION="6.18.55"
LINUX_URL="https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-${LINUX_VERSION}.tar.xz"
LINUX_SHA256="f410638061a165c12f42ab871d2f3fcd525515359b5faeee80969cff84524df9"

UBOOT_VERSION="2026.07"
UBOOT_URL="https://ftp.denx.de/pub/u-boot/u-boot-${UBOOT_VERSION}.tar.bz2"
UBOOT_SHA256="78e8bfc382fe388f9b55aa1daf8c563522a037779b5d4c349d1415e381f1243e"

# OP-TEE provides PSCI (SMP bring-up, reboot/poweroff) on RK322x.
OPTEE_REPO="https://github.com/OP-TEE/optee_os.git"
OPTEE_COMMIT="753afbbee1682f5d16fd30e87b31058a4fd4f4b8" # 4.10.0

# Kernel patches from Armbian's RK322x port, pinned to one commit (their
# rk322x.dtsi hunks are dropped; the board DTS carries those changes):
#   driver-rk322x-audio-codec   internal audio codec (headphone jack, speaker)
#   rk322x-usb-reset-props      reset the USB controllers at probe, as the
#                               bootloader may leave them unusable
#   rk322x-dwc2-no-clock-gating OTG controller quirk
#   general-dwc2-*              Rockchip dwc2 fixes, among them the hang when
#                               the OTG controller resets in peripheral mode
#                               ("dwc2_core_reset: HANG! Soft Reset timeout")
ARMBIAN_COMMIT="d70e0251e1b98a5c1f74f93b5312da420e9691c0"
ARMBIAN_PATCH_DIR="patch/kernel/archive/rockchip-6.18/patches.armbian"
ARMBIAN_KERNEL_PATCHES="
driver-rk322x-audio-codec.patch   3070bbc4aa0c0950f64c5f7d99f7f7372e2e6be7261c3b33048f7b43f87b46de
rk322x-usb-reset-props.patch      6531196bee50a9798d92755a64f5c15eddbad4848dad64086c41753729b8c086
rk322x-dwc2-no-clock-gating.patch 1e00cf3c91f79d36421262ae978cdddc6f29db83729a451e504ca8e054a33af9
general-dwc2-fix-wait-peripheral.patch 60ef4879e3b60a028e5542dc7c9a2afdb3a177979d50a495db70fb4ab31fa4d2
general-dwc2-fix-wait-time.patch  dcf5ade40f1dd286e853817c0c57fe0e6b580c89581a487a96b48f901b142d4e
general-dwc2-nak-gadget.patch     1f1b19a1a56a9f52b90aa65b86e65c6b1df6bdad78b06e38b131b0196e7bf361
"

# Seeed's firmware package for the Core v2, for the AP6212 Bluetooth patch
# (bcm43438a1.hcd) its image used. Debian's BCM43430A1.hcd is the Raspberry
# Pi's and leaves this module unresponsive after loading.
SEEED_RKFW_URL="http://respeaker.seeed.io/deb/pool/main/r/rk-firmware/rk-firmware_2018.06.09~re+20180609+1_armhf.deb"
SEEED_RKFW_SHA256="5ed48a8249ddd7f0711b3560001de2c3abc37bfb7ba189e040532dd1b5ddc571"
SEEED_BT_HCD_SHA256="a5ba3a8a0b8c589db88ebc65f59a813ecfb1ca20a47dfae59dfad63f08c5c21c"

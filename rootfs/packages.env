# Packages installed on top of Debian's minbase. Keep it lean: 1 GiB of RAM,
# 4 GB of eMMC. Everything else is one "apt install" away on the board.
ROOTFS_PACKAGES="
	systemd-sysv systemd-timesyncd systemd-zram-generator udev dbus kmod
	libpam-systemd polkitd
	iproute2 iputils-ping netbase ca-certificates curl
	network-manager wpasupplicant wireless-regdb iw rfkill
	bluez avahi-daemon libnss-mdns openssh-server
	firmware-brcm80211 bluez-firmware
	alsa-utils i2c-tools gpiod usbutils
	fdisk e2fsprogs rsync xz-utils u-boot-tools util-linux-extra
	sudo less nano vim-tiny procps psmisc htop bash-completion tzdata
"
